{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "SchoolMeritPoints: Run Server (port 8080)",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/server.py",
			"args": [
				"--port",
				"8080"
			],
			"console": "integratedTerminal",
			"justMyCode": true
		},
		{
			"name": "SchoolMeritPoints: Run Full Test Suite",
			"type": "debugpy",
			"request": "launch",
			"module": "unittest",
			"args": [
				"discover",
				"-s",
				"tests",
				"-v"
			],
			"console": "integratedTerminal",
			"justMyCode": true
		},
		{
			"name": "SchoolMeritPoints: Debug Current Test File",
			"type": "debugpy",
			"request": "launch",
			"module": "unittest",
			"args": [
				"${relativeFile}",
				"-v"
			],
			"console": "integratedTerminal",
			"justMyCode": true
		}
	]
}
