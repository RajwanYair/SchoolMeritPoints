#!/bin/sh
# Pre-commit quality gate for SchoolMeritPoints:
# Runs the full unit, API, frontend/i18n, and doc/config test suite before any commit.
set -e
PYTHON_BIN="/usr/intel/bin/python3"
if [ ! -x "$PYTHON_BIN" ]; then
  PYTHON_BIN="python3"
fi
echo "[pre-commit] Running SchoolMeritPoints automated test suite..."
"$PYTHON_BIN" -m unittest discover -s tests -v
